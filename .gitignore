research_env/
data/
results/
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.DS_Store
keepa.md

# Pytest and coverage cache
.pytest_cache/
.coverage
htmlcov/

# Matplotlib font/config cache (use MPLCONFIGDIR=/tmp/mpl_cache instead)
.matplotlib/

# ML generated files — models, results, and publication outputs are
# reproducible from source and are tracked via .gitkeep sentinels only.
ml/models/*
!ml/models/.gitkeep

ml/checkpoints/*
!ml/checkpoints/.gitkeep

ml/results/*
!ml/results/.gitkeep

ml/dataset/ml_training/*
!ml/dataset/ml_training/.gitkeep